#!/bin/sh

[ -z "$1" ] && echo "Error: should be called from udhcpc" && exit 1

case "$1" in
	deconfig) ;;
	renew|bound)
		# Print one "export KEY=\"VALUE\"" assignment per environment
		# variable. Split KEY and VALUE on the first '=' only, so values
		# containing '=' are preserved.
		env | while IFS= read -r line; do
			case "$line" in
				*=*) printf 'export %s="%s"\n' "${line%%=*}" "${line#*=}" ;;
			esac
		done ;;
esac

exit 0
