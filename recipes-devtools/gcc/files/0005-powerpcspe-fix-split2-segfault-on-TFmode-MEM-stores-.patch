From 320a048ad8f4cdf2cb4fc10d90097e887870f245 Mon Sep 17 00:00:00 2001
From: Alessio Igor Bogani <alessio.bogani@elettra.eu>
Date: Mon, 4 May 2026 09:00:35 +0200
Subject: [PATCH 5/6] powerpcspe: fix split2 segfault on TFmode MEM stores
 under STRICT_ALIGNMENT

The split of *mov<FMOVE128>_softfloat (TFmode store via the soft-float
multireg path) crashed in split2 with a NULL-deref segfault inside
mark_label_nuses, because rs6000_split_multireg_move emitted insns of
the form (set (nil) (reg:DF X)) -- a SET with a NULL destination.

Root cause: rs6000_split_multireg_move uses simplify_gen_subreg to
slice the dst/src operands at the per-register offset.  For a MEM
operand, simplify_subreg's MEM-splitting branch refuses when
STRICT_ALIGNMENT is on and MEM_ALIGN < GET_MODE_ALIGNMENT (outermode);
control then falls through to validate_subreg, which (post-LRA) refuses
size-changing FP<->FP subregs, so simplify_gen_subreg returns NULL.

This bites the SPE (e500) target hard: linuxspe.h sets MASK_STRICT_ALIGN
in TARGET_DEFAULT, so STRICT_ALIGNMENT is on by default.  TFmode is
laid out with 4-byte alignment in GPR memory (e.g. an outgoing argument
slot at sp+8), and the multireg-move splitter walks it as two DFmode
pieces -- so simplify_gen_subreg(DFmode, mem:TF[r1+8], TFmode, 0)
returns NULL.

Reproducer (cross to powerpc-linux-gnuspe, -mcpu=8548 -mabi=spe -mspe
-mfloat-gprs=double -mlong-double-128 -O2):

  struct S {
    virtual long do_put(long, bool, int, char, long double) const;
    long __do_put(long s, bool i, int io, char f, double u) const
    { return this->do_put(s, i, io, f, (long double) u); }
  };
  long g(const S& s, double d) { return s.__do_put(0, true, 0, ' ', d); }

This is the same shape as libstdc++'s
__gnu_cxx_ldbl128::money_put<>::__do_put (locale_facets_nonio.tcc:589),
which is how the bug surfaces during a Yocto/OE gcc-runtime build.

Fix: use adjust_address for MEM operands when slicing.  adjust_address
is the right primitive for "give me this MEM at offset N in a smaller
mode" -- it always succeeds and produces a MEM with mode-appropriate
alias info.  For REGs we still want simplify_gen_subreg (it computes
the correct hard-reg number for the inner mode).  Encapsulate the
MEM-vs-REG choice in a local split_part lambda and route all four
call sites in rs6000_split_multireg_move through it.

No functional change for REG operands.  For MEM operands, this matches
what upstream rs6000.cc already does for opaque OO/XO modes
(adjust_address + gen_rtx_REG); we extend it to all multireg moves so
that under-aligned MEMs work too.

Verified: the reproducer above and a battery of TFmode patterns
(extends, truncates, arithmetic, loads/stores, virtual-call args)
compile cleanly at -O0/-O2/-O3/-Os with the SPE cross compiler.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 gcc/config/powerpcspe/powerpcspe.cc | 34 ++++++++++++++++-------------
 1 file changed, 19 insertions(+), 15 deletions(-)

diff --git a/gcc/config/powerpcspe/powerpcspe.cc b/gcc/config/powerpcspe/powerpcspe.cc
index 06a40ed4457..5888a29d5d2 100644
--- a/gcc/config/powerpcspe/powerpcspe.cc
+++ b/gcc/config/powerpcspe/powerpcspe.cc
@@ -26817,63 +26817,69 @@ rs6000_split_multireg_move (rtx dst, rtx src)
   else if (ALTIVEC_REGNO_P (reg))
     reg_mode = V16QImode;
   else if (TARGET_E500_DOUBLE && FLOAT128_2REG_P (mode))
     reg_mode = DFmode;
   else
     reg_mode = word_mode;
   reg_mode_size = GET_MODE_SIZE (reg_mode);
 
   gcc_assert (reg_mode_size * nregs == GET_MODE_SIZE (mode));
 
+  /* Slice OP at byte offset OFFS for MODE/REG_MODE.  For MEM use
+     adjust_address, which always works; simplify_gen_subreg can return
+     NULL for under-aligned MEMs under STRICT_ALIGNMENT (e.g. SPE TFmode
+     stored at a 4-byte-aligned address with reg_mode == DFmode).  */
+  auto split_part = [&] (rtx op, int offs) -> rtx {
+    if (MEM_P (op))
+      return adjust_address (op, reg_mode, offs);
+    return simplify_gen_subreg (reg_mode, op, mode, offs);
+  };
+
   /* TDmode residing in FP registers is special, since the ISA requires that
      the lower-numbered word of a register pair is always the most significant
      word, even in little-endian mode.  This does not match the usual subreg
      semantics, so we cannnot use simplify_gen_subreg in those cases.  Access
      the appropriate constituent registers "by hand" in little-endian mode.
 
      Note we do not need to check for destructive overlap here since TDmode
      can only reside in even/odd register pairs.  */
   if (FP_REGNO_P (reg) && DECIMAL_FLOAT_MODE_P (mode) && !BYTES_BIG_ENDIAN)
     {
       rtx p_src, p_dst;
       int i;
 
       for (i = 0; i < nregs; i++)
 	{
 	  if (REG_P (src) && FP_REGNO_P (REGNO (src)))
 	    p_src = gen_rtx_REG (reg_mode, REGNO (src) + nregs - 1 - i);
 	  else
-	    p_src = simplify_gen_subreg (reg_mode, src, mode,
-					 i * reg_mode_size);
+	    p_src = split_part (src, i * reg_mode_size);
 
 	  if (REG_P (dst) && FP_REGNO_P (REGNO (dst)))
 	    p_dst = gen_rtx_REG (reg_mode, REGNO (dst) + nregs - 1 - i);
 	  else
-	    p_dst = simplify_gen_subreg (reg_mode, dst, mode,
-					 i * reg_mode_size);
+	    p_dst = split_part (dst, i * reg_mode_size);
 
 	  emit_insn (gen_rtx_SET (p_dst, p_src));
 	}
 
       return;
     }
 
   if (REG_P (src) && REG_P (dst) && (REGNO (src) < REGNO (dst)))
     {
       /* Move register range backwards, if we might have destructive
 	 overlap.  */
       int i;
       for (i = nregs - 1; i >= 0; i--)
-	emit_insn (gen_rtx_SET (simplify_gen_subreg (reg_mode, dst, mode,
-						     i * reg_mode_size),
-				simplify_gen_subreg (reg_mode, src, mode,
-						     i * reg_mode_size)));
+	emit_insn (gen_rtx_SET (split_part (dst, i * reg_mode_size),
+				split_part (src, i * reg_mode_size)));
     }
   else
     {
       int i;
       int j = -1;
       bool used_update = false;
       rtx restore_basereg = NULL_RTX;
 
       if (MEM_P (src) && INT_REGNO_P (reg))
 	{
@@ -26890,21 +26896,21 @@ rs6000_split_multireg_move (rtx dst, rtx src)
 	      emit_insn (gen_add3_insn (breg, breg, delta_rtx));
 	      src = replace_equiv_address (src, breg);
 	    }
 	  else if (! rs6000_offsettable_memref_p (src, reg_mode))
 	    {
 	      if (GET_CODE (XEXP (src, 0)) == PRE_MODIFY)
 		{
 		  rtx basereg = XEXP (XEXP (src, 0), 0);
 		  if (TARGET_UPDATE)
 		    {
-		      rtx ndst = simplify_gen_subreg (reg_mode, dst, mode, 0);
+		      rtx ndst = split_part (dst, 0);
 		      emit_insn (gen_rtx_SET (ndst,
 					      gen_rtx_MEM (reg_mode,
 							   XEXP (src, 0))));
 		      used_update = true;
 		    }
 		  else
 		    emit_insn (gen_rtx_SET (basereg,
 					    XEXP (XEXP (src, 0), 1)));
 		  src = replace_equiv_address (src, basereg);
 		}
@@ -26938,41 +26944,41 @@ rs6000_split_multireg_move (rtx dst, rtx src)
 	      breg = XEXP (XEXP (dst, 0), 0);
 	      delta_rtx = (GET_CODE (XEXP (dst, 0)) == PRE_INC
 			   ? GEN_INT (GET_MODE_SIZE (GET_MODE (dst)))
 			   : GEN_INT (-GET_MODE_SIZE (GET_MODE (dst))));
 
 	      /* We have to update the breg before doing the store.
 		 Use store with update, if available.  */
 
 	      if (TARGET_UPDATE)
 		{
-		  rtx nsrc = simplify_gen_subreg (reg_mode, src, mode, 0);
+		  rtx nsrc = split_part (src, 0);
 		  emit_insn (TARGET_32BIT
 			     ? (TARGET_POWERPC64
 				? gen_movdi_si_update (breg, breg, delta_rtx, nsrc)
 				: gen_movsi_update (breg, breg, delta_rtx, nsrc))
 			     : gen_movdi_di_update (breg, breg, delta_rtx, nsrc));
 		  used_update = true;
 		}
 	      else
 		emit_insn (gen_add3_insn (breg, breg, delta_rtx));
 	      dst = replace_equiv_address (dst, breg);
 	    }
 	  else if (!rs6000_offsettable_memref_p (dst, reg_mode)
 		   && GET_CODE (XEXP (dst, 0)) != LO_SUM)
 	    {
 	      if (GET_CODE (XEXP (dst, 0)) == PRE_MODIFY)
 		{
 		  rtx basereg = XEXP (XEXP (dst, 0), 0);
 		  if (TARGET_UPDATE)
 		    {
-		      rtx nsrc = simplify_gen_subreg (reg_mode, src, mode, 0);
+		      rtx nsrc = split_part (src, 0);
 		      emit_insn (gen_rtx_SET (gen_rtx_MEM (reg_mode,
 							   XEXP (dst, 0)),
 					      nsrc));
 		      used_update = true;
 		    }
 		  else
 		    emit_insn (gen_rtx_SET (basereg,
 					    XEXP (XEXP (dst, 0), 1)));
 		  dst = replace_equiv_address (dst, basereg);
 		}
@@ -27004,24 +27010,22 @@ rs6000_split_multireg_move (rtx dst, rtx src)
 	  /* Calculate index to next subword.  */
 	  ++j;
 	  if (j == nregs)
 	    j = 0;
 
 	  /* If compiler already emitted move of first word by
 	     store with update, no need to do anything.  */
 	  if (j == 0 && used_update)
 	    continue;
 
-	  emit_insn (gen_rtx_SET (simplify_gen_subreg (reg_mode, dst, mode,
-						       j * reg_mode_size),
-				  simplify_gen_subreg (reg_mode, src, mode,
-						       j * reg_mode_size)));
+	  emit_insn (gen_rtx_SET (split_part (dst, j * reg_mode_size),
+				  split_part (src, j * reg_mode_size)));
 	}
       if (restore_basereg != NULL_RTX)
 	emit_insn (restore_basereg);
     }
 }
 
 
 /* This page contains routines that are used to determine what the
    function prologue and epilogue code will do and write them out.  */
 
