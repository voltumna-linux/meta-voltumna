+/* Implement TARGET_C_MODE_FOR_FLOATING_TYPE.  Return DFmode for the
+   long-double type on SPE (rs6000_long_double_type_size == 64), TFmode
+   when the variant with IEEE 128 / IBM long double is requested.  Delegate
+   other floating types to the middle-end default.  */
+
+static machine_mode
+rs6000_c_mode_for_floating_type (enum tree_index ti)
+{
+  if (ti == TI_LONG_DOUBLE_TYPE)
+    return rs6000_long_double_type_size == 128 ? TFmode : DFmode;
+  return default_mode_for_floating_type (ti);
+}
