diff --git a/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst b/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst
new file mode 100644
index 00000000000..ae474ef6375
--- /dev/null
+++ b/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst
@@ -0,0 +1,5 @@
+Fix build of the ``termios`` module on platforms where ``<sys/ioctl.h>``
+references ``struct termio`` in the ``TCGETA``/``TCSETA``/``TCSETAF``/
+``TCSETAW`` ioctl macros without itself defining the struct. Configure
+now probes for ``<termio.h>`` and ``Modules/termios.c`` includes it when
+available so the struct is complete when those macros are expanded.
diff --git a/Modules/termios.c b/Modules/termios.c
index efb5fcc17fa..362633ed416 100644
--- a/Modules/termios.c
+++ b/Modules/termios.c
@@ -3,20 +3,27 @@
 // Need limited C API version 3.13 for PyLong_AsInt()
 // in code generated by Argument Clinic.
 #include "pyconfig.h"   // Py_GIL_DISABLED
 #ifndef Py_GIL_DISABLED
 #  define Py_LIMITED_API 0x030d0000
 #endif
 
 #include "Python.h"
 
 #include <string.h>               // memset()
+// On Linux/glibc, <bits/ioctls.h> (included by <sys/ioctl.h>) references
+// struct termio in TCGETA/TCSETA/TCSETAW/TCSETAF macros without including
+// the header that defines it. Include <termio.h> first when available so
+// the struct is complete by the time those macros are expanded below.
+#if defined(HAVE_TERMIO_H)
+#  include <termio.h>
+#endif
 #include <sys/ioctl.h>
 #include <termios.h>
 #include <unistd.h>               // _POSIX_VDISABLE
 
 // On QNX 6, struct termio must be declared by including sys/termio.h
 // if TCGETA, TCSETA, TCSETAW, or TCSETAF are used. sys/termio.h must
 // be included before termios.h or it will generate an error.
 #if defined(HAVE_SYS_TERMIO_H) && !defined(__hpux)
 #  include <sys/termio.h>
 #endif
diff --git a/configure b/configure
index 645628fecf2..0d2b7244115 100755
--- a/configure
+++ b/configure
@@ -11678,20 +11678,26 @@ ac_fn_c_check_header_compile "$LINENO" "sysexits.h" "ac_cv_header_sysexits_h" "$
 if test "x$ac_cv_header_sysexits_h" = xyes
 then :
   printf "%s\n" "#define HAVE_SYSEXITS_H 1" >>confdefs.h
 
 fi
 ac_fn_c_check_header_compile "$LINENO" "syslog.h" "ac_cv_header_syslog_h" "$ac_includes_default"
 if test "x$ac_cv_header_syslog_h" = xyes
 then :
   printf "%s\n" "#define HAVE_SYSLOG_H 1" >>confdefs.h
 
+fi
+ac_fn_c_check_header_compile "$LINENO" "termio.h" "ac_cv_header_termio_h" "$ac_includes_default"
+if test "x$ac_cv_header_termio_h" = xyes
+then :
+  printf "%s\n" "#define HAVE_TERMIO_H 1" >>confdefs.h
+
 fi
 ac_fn_c_check_header_compile "$LINENO" "termios.h" "ac_cv_header_termios_h" "$ac_includes_default"
 if test "x$ac_cv_header_termios_h" = xyes
 then :
   printf "%s\n" "#define HAVE_TERMIOS_H 1" >>confdefs.h
 
 fi
 ac_fn_c_check_header_compile "$LINENO" "util.h" "ac_cv_header_util_h" "$ac_includes_default"
 if test "x$ac_cv_header_util_h" = xyes
 then :
