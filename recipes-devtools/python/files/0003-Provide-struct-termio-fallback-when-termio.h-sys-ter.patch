From 378fe64f2a0361b3941466801a9eb7385966289c Mon Sep 17 00:00:00 2001
From: Alessio Igor Bogani <alessio.bogani@elettra.eu>
Date: Tue, 5 May 2026 13:21:50 +0200
Subject: [PATCH 3/3] Provide struct termio fallback when
 <termio.h>/<sys/termio.h> are absent

Some toolchains (notably some PowerPC SPE Yocto/glibc sysroots, and
musl-based environments) ship neither <termio.h> nor <sys/termio.h>
even though <sys/ioctl.h> still expands TCGETA/TCSETA/TCSETAW/TCSETAF
to _IOR('T', N, struct termio). In that configuration the previous
fix was a no-op and the build failed with:

    invalid application of 'sizeof' to incomplete type 'struct termio'

Restructure the include ordering in Modules/termios.c to prefer
<sys/termio.h>, then <termio.h>, and on Linux fall back to a local
definition of struct termio that matches the kernel UAPI layout from
<asm-generic/termbits.h> (identical across every Linux arch, PowerPC
included). This both unblocks the build on stripped-down sysroots and
keeps the TCGETA et al. ioctl values byte-correct so they can still be
used with fcntl.ioctl(). Pulling <sys/termio.h> in early also satisfies
the QNX requirement that it precede <termios.h>.
---

Upstream-Status: Inappropriate

 .../2026-05-04-12-00-00.gh-issue-0.74122e.rst | 10 +++--
 Modules/termios.c                             | 37 +++++++++++++------
 2 files changed, 32 insertions(+), 15 deletions(-)

diff --git a/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst b/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst
index ae474ef6375..c762d089242 100644
--- a/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst
+++ b/Misc/NEWS.d/next/Build/2026-05-04-12-00-00.gh-issue-0.74122e.rst
@@ -1,5 +1,9 @@
 Fix build of the ``termios`` module on platforms where ``<sys/ioctl.h>``
 references ``struct termio`` in the ``TCGETA``/``TCSETA``/``TCSETAF``/
-``TCSETAW`` ioctl macros without itself defining the struct. Configure
-now probes for ``<termio.h>`` and ``Modules/termios.c`` includes it when
-available so the struct is complete when those macros are expanded.
+``TCSETAW`` ioctl macros without itself defining the struct (notably some
+PowerPC SPE Yocto toolchains where the C library ships neither
+``<termio.h>`` nor ``<sys/termio.h>``). ``Modules/termios.c`` now includes
+``<sys/termio.h>`` or ``<termio.h>`` when available, and on Linux falls
+back to the kernel UAPI definition of ``struct termio`` so the ioctl
+constants can still be exposed. Including ``<sys/termio.h>`` earlier also
+satisfies the QNX requirement that it precede ``<termios.h>``.
diff --git a/Modules/termios.c b/Modules/termios.c
index 362633ed416..5659c5d0f49 100644
--- a/Modules/termios.c
+++ b/Modules/termios.c
@@ -3,38 +3,51 @@
 // Need limited C API version 3.13 for PyLong_AsInt()
 // in code generated by Argument Clinic.
 #include "pyconfig.h"   // Py_GIL_DISABLED
 #ifndef Py_GIL_DISABLED
 #  define Py_LIMITED_API 0x030d0000
 #endif
 
 #include "Python.h"
 
 #include <string.h>               // memset()
-// On Linux/glibc, <bits/ioctls.h> (included by <sys/ioctl.h>) references
-// struct termio in TCGETA/TCSETA/TCSETAW/TCSETAF macros without including
-// the header that defines it. Include <termio.h> first when available so
-// the struct is complete by the time those macros are expanded below.
-#if defined(HAVE_TERMIO_H)
+// On Linux/glibc and QNX, the TCGETA/TCSETA/TCSETAW/TCSETAF ioctl macros
+// (referenced below when those constants are defined) expand to
+// _IOR('T', N, struct termio), so 'struct termio' must be a complete type
+// at the point of use. The kernel/UAPI <bits/ioctls.h> pulled in by
+// <sys/ioctl.h> only forward-references the struct without defining it,
+// and not every C library / sysroot ships <termio.h> or <sys/termio.h>
+// (some glibc and musl configurations strip these System V headers).
+//
+// Strategy: prefer the System V headers when available; otherwise, on
+// Linux, fall back to the kernel UAPI definition from
+// <asm-generic/termbits.h>, which is identical across every Linux arch
+// (powerpc included). Including <sys/termio.h> early also satisfies the
+// QNX requirement that it precede <termios.h>.
+#if defined(HAVE_SYS_TERMIO_H) && !defined(__hpux)
+#  include <sys/termio.h>
+#elif defined(HAVE_TERMIO_H)
 #  include <termio.h>
+#elif defined(__linux__)
+struct termio {
+    unsigned short c_iflag;
+    unsigned short c_oflag;
+    unsigned short c_cflag;
+    unsigned short c_lflag;
+    unsigned char c_line;
+    unsigned char c_cc[8];
+};
 #endif
 #include <sys/ioctl.h>
 #include <termios.h>
 #include <unistd.h>               // _POSIX_VDISABLE
 
-// On QNX 6, struct termio must be declared by including sys/termio.h
-// if TCGETA, TCSETA, TCSETAW, or TCSETAF are used. sys/termio.h must
-// be included before termios.h or it will generate an error.
-#if defined(HAVE_SYS_TERMIO_H) && !defined(__hpux)
-#  include <sys/termio.h>
-#endif
-
 // Apparently, on SGI, termios.h won't define CTRL if _XOPEN_SOURCE
 // is defined, so we define it here.
 #if defined(__sgi)
 #  define CTRL(c) ((c)&037)
 #endif
 
 // We could do better. Check bpo-32660
 #if defined(__sun)
 #  include <sys/filio.h>
 #  include <sys/sockio.h>
