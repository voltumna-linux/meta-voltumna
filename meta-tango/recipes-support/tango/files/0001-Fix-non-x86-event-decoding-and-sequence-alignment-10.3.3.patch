+            std::memcpy(the_seq.get_buffer(), raw, static_cast<std::size_t>(length) * sizeof(T));
+        }
+        raw = reinterpret_cast<char *>(the_seq.get_buffer());
     }
 
     if(_n.unmarshal_byte_swap())
     {
+        //
+        // Load/store each element via memcpy so the byte-swap stays correct even when the
+        // ZMQ buffer is not aligned on a sizeof(T) boundary (strict-alignment targets).
+        //
         if(sizeof(T) == 2)
         {
             for(CORBA::ULong i = 0; i < length; i++)
             {
-                _CORBA_UShort *tmp_ptr = (_CORBA_UShort *) ptr;
-                _CORBA_UShort tt = *(tmp_ptr + i);
-                *(tmp_ptr + i) = Swap16(tt);
+                _CORBA_UShort tt;
+                std::memcpy(&tt, raw + static_cast<std::size_t>(i) * 2, sizeof(tt));
