 template <typename T, typename TA>
 inline void ZmqAttrValUnion::init_seq(char *base_ptr, CORBA::ULong &length, TangoCdrMemoryStream &_n)
 {
     TA dummy_val;
     set_seq<TA>(dummy_val);
 
-    T *ptr;
+    char *raw;
     if(_n.get_un_marshal_type() == TangoCdrMemoryStream::UN_ATT)
