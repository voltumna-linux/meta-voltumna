+                std::memcpy(raw + static_cast<std::size_t>(i) * 2, &tt, sizeof(tt));
             }
         }
         else if(sizeof(T) == 4)
         {
             for(CORBA::ULong i = 0; i < length; i++)
             {
-                CORBA::ULong *tmp_ptr = (CORBA::ULong *) ptr;
-                CORBA::ULong t = *(tmp_ptr + i);
-                *(tmp_ptr + i) = Swap32(t);
+                CORBA::ULong t;
+                std::memcpy(&t, raw + static_cast<std::size_t>(i) * 4, sizeof(t));
+                t = Swap32(t);
+                std::memcpy(raw + static_cast<std::size_t>(i) * 4, &t, sizeof(t));
             }
         }
         else if(sizeof(T) == 8)
         {
-            CORBA::ULong double_length = length * 2;
-            for(CORBA::ULong i = 0; i < double_length; i += 2)
+            for(CORBA::ULong i = 0; i < length; i++)
             {
-                CORBA::ULong *tmp_ptr = (CORBA::ULong *) ptr;
-                CORBA::ULong tl1 = *(tmp_ptr + i + 1);
-                CORBA::ULong tl2 = Swap32(tl1);
-                tl1 = *(tmp_ptr + i);
-                *(tmp_ptr + i) = tl2;
-                *(tmp_ptr + i + 1) = Swap32(tl1);
+                CORBA::ULong w0, w1;
+                std::memcpy(&w0, raw + static_cast<std::size_t>(i) * 8, sizeof(w0));
+                std::memcpy(&w1, raw + static_cast<std::size_t>(i) * 8 + 4, sizeof(w1));
+                CORBA::ULong s0 = Swap32(w1);
+                CORBA::ULong s1 = Swap32(w0);
+                std::memcpy(raw + static_cast<std::size_t>(i) * 8, &s0, sizeof(s0));
+                std::memcpy(raw + static_cast<std::size_t>(i) * 8 + 4, &s1, sizeof(s1));
             }
         }
     }
 
-    TA &the_seq = get_seq<TA>();
-    the_seq.replace(length, length, ptr, false);
+    if(!needs_copy)
