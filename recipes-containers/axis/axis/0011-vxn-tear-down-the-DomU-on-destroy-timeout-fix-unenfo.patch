     fn destroy(&mut self) -> Result<(), SandboxError> {
+        // The DomU must be stopped unless the run already exited cleanly on its
+        // own (where `--rm` has torn it down). It may still be live if: we hold a
+        // Child to kill; the frontend was force-killed on timeout; or no exit was
+        // ever observed (e.g. the interactive wait was cancelled and the Child is
+        // in a blocking task, so self.child is None but the DomU is up).
+        let needs_stop =
+            self.child.is_some() || self.force_killed || self.exit_code.is_none();
+
         if let Some(mut child) = self.child.take() {
+            self.force_killed = true;
             Self::kill_child(&mut child);
-            if self.exit_code.is_none() {
-                self.exit_code = Some(-1);
+        } else if self.exit_code.is_none() {
+            // The Child was moved into wait()'s blocking task; signal by the
+            // retained pid so the frontend actually stops (and that task's
+            // child.wait() returns). Killing the frontend alone is not enough,
+            // hence the explicit stop_domu() below.
+            if let Some(pid) = self.pid {
+                self.force_killed = true;
+                Self::kill_pid(pid);
             }
         }
-        // TODO(vxn/axis): `vxn run --rm` cleans the DomU on normal exit, but on a
-        // hard kill the DomU may linger; a best-effort `vxn rm` / `xl destroy` by
-        // domain name belongs here once we track it. Idempotent (contract).
+        if self.exit_code.is_none() {
+            self.exit_code = Some(-1);
+        }
+
+        // Stop the DomU before reporting success. Killing the frontend does not
+        // enforce the timeout / fail-closed contract: a lingering VM would be
+        // treated as destroyed and the manager would stop cleanup retries.
+        if needs_stop {
+            self.stop_domu()?;
+        }
+
         tracing::info!("sandbox {} destroyed (vxn backend)", self.id);
         Ok(())
     }
